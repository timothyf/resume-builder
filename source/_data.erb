<% @resume_context = build_resume_context(data.active_resume) %>
<% @active_resume_user = @resume_context[:user] %>
<% @active_resume_name = @resume_context[:name] %>
<% @resume_data = @resume_context[:resume] %>
<% @layout_data = @resume_context[:layout] %>
<% @skills_data = @resume_context[:skills] %>
<% @skills_by_id = @skills_data.each_with_object({}) { |skill, index| index[skill.id.to_s] = skill } %>
<% @publications_data = @resume_context[:publications] %>
<% @publications_by_id = @publications_data.each_with_object({}) { |publication, index| index[publication.id.to_s] = publication } %>
<% @community_data = @resume_context[:community] %>
<% @community_by_id = @community_data.each_with_object({}) { |community, index| index[community.id.to_s] = community } %>
<% @job_data = @resume_context[:jobs] %>
<% @jobs_by_id = @job_data.each_with_object({}) { |job, index| index[job.id.to_s] = job } %>
