<div class="company">
    <% if job.url? %>
      <h2 class="company-name"><a href="<%= job.url%>" target=_blank><%= job.company %></a></h2>
    <% else %>
      <h2 class="company-name"><%= job.company %> 
       <%= partial 'templates/experience/company_location', :locals => {:job => job} %>
</h2>
    <% end %>
</div>
